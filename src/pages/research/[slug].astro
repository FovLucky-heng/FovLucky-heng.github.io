---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import FavoriteButton from '../../components/FavoriteButton';
import ArticleCard from '../../components/ArticleCard.astro';
import RiskNotice from '../../components/RiskNotice.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import type { ArticleEntry } from '../../lib/articles';
import { getPublishedArticles, getRelatedArticles } from '../../lib/articles';
import { formatDate, formatDateShort } from '../../lib/format';
import { AUTHOR, SITE } from '../../lib/site';

export async function getStaticPaths() {
  const articles = await getPublishedArticles();
  return articles.map((article) => ({
    params: { slug: article.data.slug },
    props: { article },
  }));
}

interface Props {
  article: ArticleEntry;
}

const { article } = Astro.props;
const { Content, headings } = await render(article);
const toc = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
const allArticles = await getPublishedArticles();
const related = getRelatedArticles(article, allArticles, 3);

const configuredSite = Astro.site ?? new URL('https://hengyuan-research.example.com');
const articleUrl = new URL(`/research/${article.data.slug}/`, configuredSite).toString();
const coverUrl = new URL(article.data.cover, configuredSite).toString();
const aboutUrl = new URL('/about/', configuredSite).toString();
const logoUrl = new URL('/favicon.svg', configuredSite).toString();

const articleSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BlogPosting',
      '@id': `${articleUrl}#article`,
      headline: article.data.title,
      description: article.data.description,
      image: [coverUrl],
      datePublished: article.data.date.toISOString(),
      dateModified: article.data.date.toISOString(),
      author: {
        '@type': 'Person',
        name: article.data.author,
        url: aboutUrl,
      },
      publisher: {
        '@type': 'Organization',
        name: SITE.name,
        alternateName: SITE.english,
        logo: { '@type': 'ImageObject', url: logoUrl },
      },
      mainEntityOfPage: { '@type': 'WebPage', '@id': articleUrl },
      articleSection: article.data.category,
      keywords: article.data.tags.join(', '),
      inLanguage: 'zh-CN',
      isAccessibleForFree: true,
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: '首页', item: configuredSite.origin },
        {
          '@type': 'ListItem',
          position: 2,
          name: '研究档案',
          item: new URL('/research/', configuredSite).toString(),
        },
        { '@type': 'ListItem', position: 3, name: article.data.title, item: articleUrl },
      ],
    },
  ],
};
---

<BaseLayout
  title={article.data.title}
  description={article.data.description}
  image={article.data.cover}
  imageAlt={`${article.data.title} — 衡远研究封面插图`}
  imageWidth={1600}
  imageHeight={1000}
  type="article"
  publishedTime={article.data.date.toISOString()}
  articleSection={article.data.category}
  author={article.data.author}
  tags={article.data.tags}
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(articleSchema)} />

  <article>
    <header class="shell pt-8 sm:pt-12">
      <Breadcrumbs
        items={[
          { label: '首页', href: '/' },
          { label: '研究档案', href: '/research/' },
          { label: article.data.category, href: `/research/?category=${encodeURIComponent(article.data.category)}` },
          { label: article.data.title },
        ]}
      />

      <div class="mx-auto mt-10 max-w-4xl text-center sm:mt-14">
        <div class="flex flex-wrap items-center justify-center gap-x-4 gap-y-2 text-[0.68rem] tracking-[0.08em] text-muted">
          <span class="border border-accent/50 bg-accent-soft/45 px-2.5 py-1 font-medium text-accent-deep">
            {article.data.category}
          </span>
          <span>{article.data.readingTime} 分钟阅读</span>
          <span aria-hidden="true">/</span>
          <time datetime={article.data.date.toISOString()}>{formatDate(article.data.date)}</time>
        </div>

        <h1 class="display-title headline-keep mt-6 text-[clamp(2.15rem,4.8vw,4rem)] text-ink">
          {article.data.title}
        </h1>

        <p class="mx-auto mt-6 max-w-2xl text-[0.95rem] leading-8 text-muted sm:text-base">
          {article.data.description}
        </p>

        <div class="mt-8 flex flex-wrap items-center justify-center gap-x-6 gap-y-4 border-t border-line pt-6">
          <div class="flex items-center gap-3 text-left">
            <span class="flex h-9 w-9 items-center justify-center bg-ink font-serif text-base text-paper">
              林
            </span>
            <div>
              <p class="text-xs font-semibold text-ink">{article.data.author}</p>
              <p class="mt-0.5 text-[0.62rem] text-muted">{AUTHOR.credential} · {AUTHOR.role}</p>
            </div>
          </div>
          <span class="hidden h-8 w-px bg-line sm:block" aria-hidden="true"></span>
          <p class="text-[0.68rem] text-muted">
            发布于 <time datetime={article.data.date.toISOString()}>{formatDateShort(article.data.date)}</time>
          </p>
          <FavoriteButton
            client:load
            slug={article.data.slug}
            title={article.data.title}
            className="ml-0 sm:ml-2"
          />
        </div>
      </div>
    </header>

    <figure class="shell mt-10 sm:mt-14">
      <div class="mx-auto max-w-6xl overflow-hidden border border-line bg-paper-deep">
        <img
          src={article.data.cover}
          alt={`${article.data.title} 封面插图`}
          width="1600"
          height="1000"
          loading="eager"
          fetchpriority="high"
          decoding="async"
          class="aspect-[8/5] w-full object-cover"
        />
      </div>
      <figcaption class="mx-auto mt-3 flex max-w-6xl flex-wrap justify-between gap-2 text-[0.62rem] text-muted">
        <span>封面为编辑插图 / Editorial illustration</span>
        <span class="font-mono tracking-wide">HENGYUAN RESEARCH · {formatDateShort(article.data.date)}</span>
      </figcaption>
    </figure>

    <div class="shell mt-12 sm:mt-16">
      <div class="mx-auto grid max-w-6xl gap-10 lg:grid-cols-[14rem_minmax(0,46rem)] lg:justify-center lg:gap-16">
        <aside>
          <div class="lg:sticky lg:top-28">
            <details class="border border-line bg-paper-soft p-5 lg:hidden">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-xs font-semibold text-ink">
                <span>本文目录</span>
                <span class="font-mono text-[0.6rem] text-muted">{toc.length} SECTIONS</span>
              </summary>
              <nav class="mt-4 border-t border-line pt-3" aria-label="本文目录（移动端）">
                <ul>
                  {toc.map((heading) => (
                    <li>
                      <a
                        href={`#${heading.slug}`}
                        class:list={['toc-link', heading.depth === 3 && 'toc-link--nested']}
                      >
                        {heading.text}
                      </a>
                    </li>
                  ))}
                </ul>
              </nav>
            </details>

            <nav class="hidden lg:block" aria-label="本文目录">
              <p class="rule-label border-b border-line pb-3 text-muted">Contents / 目录</p>
              <ul class="mt-3">
                {toc.map((heading) => (
                  <li>
                    <a
                      href={`#${heading.slug}`}
                      class:list={['toc-link', heading.depth === 3 && 'toc-link--nested']}
                    >
                      {heading.text}
                    </a>
                  </li>
                ))}
              </ul>
              <a
                href="#main"
                class="mt-6 inline-flex items-center gap-2 text-[0.62rem] tracking-wide text-muted transition-colors hover:text-ink"
              >
                <span aria-hidden="true">↑</span>
                返回顶部
              </a>
            </nav>
          </div>
        </aside>

        <div class="min-w-0">
          <div class="article-prose">
            <Content />
          </div>

          <div class="mt-10 flex flex-wrap items-center gap-2 border-t border-line pt-6">
            <span class="rule-label mr-2 text-muted">Tags / 标签</span>
            {article.data.tags.map((tag) => (
              <a
                href={`/research/?tag=${encodeURIComponent(tag)}`}
                class="border border-line px-2.5 py-1.5 text-[0.66rem] text-muted transition-colors hover:border-accent hover:text-accent-deep"
              >
                #{tag}
              </a>
            ))}
          </div>

          <div class="mt-8">
            <RiskNotice />
          </div>

          <section class="mt-8 border border-line bg-paper-soft p-6 sm:p-7" aria-label="作者介绍">
            <p class="rule-label text-muted">About the author / 作者</p>
            <div class="mt-5 flex flex-col gap-5 sm:flex-row sm:items-start">
              <span class="flex h-16 w-16 shrink-0 items-center justify-center bg-ink font-serif text-3xl text-paper">
                林
              </span>
              <div class="min-w-0 flex-1">
                <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                  <h2 class="font-serif text-xl text-ink">{AUTHOR.name}</h2>
                  <span class="text-[0.64rem] tracking-wide text-accent-deep">{AUTHOR.credential} · {AUTHOR.role}</span>
                </div>
                <p class="mt-2 text-sm leading-7 text-muted">{AUTHOR.shortBio}</p>
                <a href="/about/" class="text-link mt-4 text-xs">
                  查看作者背景与研究方法
                  <span aria-hidden="true">↗</span>
                </a>
              </div>
            </div>
          </section>

          <div class="mt-8 flex flex-wrap items-center justify-between gap-4">
            <a href="/research/" class="text-link text-xs">
              <span aria-hidden="true">←</span>
              返回研究档案
            </a>
            <p class="text-[0.62rem] text-muted">最后阅读：约 {article.data.readingTime} 分钟</p>
          </div>
        </div>
      </div>
    </div>
  </article>

  {
    related.length > 0 && (
      <section class="shell mt-20 border-t border-line pt-14 sm:mt-28" aria-labelledby="related-heading">
        <SectionHeading
          id="related-heading"
          eyebrow="Related research / 延伸阅读"
          title="继续沿着这个问题思考"
          description="根据主题与标签为你推荐的相关研究。"
          href="/research/"
          linkLabel="全部研究"
        />
        <div class="mt-10 grid gap-x-7 gap-y-12 sm:grid-cols-2 lg:grid-cols-3">
          {related.map((item) => (
            <ArticleCard article={item} />
          ))}
        </div>
      </section>
    )
  }
</BaseLayout>
