---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import FavoritesList from '../components/FavoritesList';
import { getPublishedArticles, toResearchItem } from '../lib/articles';

const articles = await getPublishedArticles();
const items = articles.map(toResearchItem);
---

<BaseLayout
  title="我的收藏"
  description="查看保存在当前浏览器中的研究收藏。收藏使用 localStorage，无需登录，也不会上传任何数据。"
  noindex={true}
>
  <section class="relative overflow-hidden border-b border-line">
    <div class="hero-grid pointer-events-none absolute inset-0" aria-hidden="true"></div>
    <div class="shell relative py-12 sm:py-16">
      <Breadcrumbs items={[{ label: '首页', href: '/' }, { label: '我的收藏' }]} />

      <div class="mt-9 flex flex-col justify-between gap-8 sm:flex-row sm:items-end">
        <div>
          <p class="eyebrow">Reading list / 我的收藏</p>
          <h1 class="display-title mt-5 text-[clamp(2.7rem,5.4vw,4.4rem)] text-ink">
            我的收藏
          </h1>
          <p class="mt-4 max-w-xl text-sm leading-8 text-muted">
            把值得反复阅读的研究留在这里。收藏保存在当前浏览器的 localStorage 中，无需登录，也不会上传。
          </p>
        </div>
        <div class="flex items-center gap-3 border border-line bg-paper-soft px-4 py-3 text-[0.65rem] text-muted">
          <svg aria-hidden="true" viewBox="0 0 24 24" class="h-4 w-4 text-accent-deep" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round">
            <path d="M6.5 4.25h11v16l-5.5-3.9-5.5 3.9v-16Z"></path>
          </svg>
          LOCAL ONLY · 仅当前设备
        </div>
      </div>
    </div>
  </section>

  <section class="shell py-10 sm:py-14">
    <noscript>
      <div class="mb-8 border border-line-dark bg-paper-soft p-5 text-sm leading-7 text-muted">
        收藏功能依赖浏览器的 JavaScript 与 localStorage。请启用 JavaScript 后刷新页面，或直接浏览
        <a href="/research/" class="text-link ml-1 text-xs">研究档案</a>。
      </div>
    </noscript>
    <FavoritesList articles={items} client:load />
  </section>
</BaseLayout>
