---
interface Props {
  id?: string;
  eyebrow: string;
  title: string;
  description?: string;
  href?: string;
  linkLabel?: string;
  inverted?: boolean;
}

const { id, eyebrow, title, description, href, linkLabel = '查看全部', inverted = false } = Astro.props;
---

<div class="flex flex-col justify-between gap-6 sm:flex-row sm:items-end">
  <div class="max-w-2xl">
    <p class:list={['eyebrow', inverted && 'eyebrow--light']}>{eyebrow}</p>
    <h2 id={id} class:list={[
      'display-title mt-4 text-3xl sm:text-4xl lg:text-[2.8rem]',
      inverted ? 'text-paper' : 'text-ink',
    ]}>
      {title}
    </h2>
    {description && (
      <p class:list={[
        'mt-4 max-w-xl text-sm leading-7',
        inverted ? 'text-paper/60' : 'text-muted',
      ]}>
        {description}
      </p>
    )}
  </div>
  {href && (
    <a
      href={href}
      class:list={[
        'text-link shrink-0',
        inverted ? 'border-paper/30 text-paper hover:border-paper hover:text-white' : '',
      ]}
    >
      {linkLabel}
      <span aria-hidden="true">↗</span>
    </a>
  )}
</div>
